model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @db.Uuid
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(100)
  details   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model SecurityLog {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?          @db.Uuid
  event     String           @db.VarChar(100)
  severity  SecuritySeverity
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime         @default(now())

  @@index([event])
  @@index([severity])
  @@index([createdAt])
  @@index([userId])
  @@map("security_logs")
}

enum SecuritySeverity {
  INFO
  WARNING
  DANGER
  CRITICAL
}

// ═══════════════════════════════════════════════════════════════════════
// SYSTEM - NEWSLETTER
// ═══════════════════════════════════════════════════════════════════════

model Newsletter {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String           @unique @db.VarChar(255)
  name           String?          @db.VarChar(200)
  status         NewsletterStatus @default(ACTIVE)
  source         String?          @db.VarChar(100)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())

  @@index([status])
  @@map("newsletters")
}

enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

// ═══════════════════════════════════════════════════════════════════════
// SYSTEM - BACKUP
// ═══════════════════════════════════════════════════════════════════════

model Backup {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename    String       @db.VarChar(300)
  fileSize    Int
  type        BackupType
  status      BackupStatus @default(IN_PROGRESS)
  location    String       @db.VarChar(500)
  notes       String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([type])
  @@index([status])
  @@map("backups")
}

enum BackupType {
  FULL
  INCREMENTAL
  DATABASE
  FILES
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

