# ─────────────────────────────────────────────────────────────────────────────
# Serene Dental — environment configuration
#
# Copy this file to `.env` (for Prisma CLI / migrations) and/or `.env.local`
# (for Next.js runtime). `.env.local` is loaded automatically by `next dev`
# and `next build`, and overrides `.env`.
#
#   cp .env.example .env.local
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (required) ─────────────────────────────────────────────────────
# Online PostgreSQL (Neon / Supabase / Railway / RDS…). The Prisma CLI reads
# this from `.env`; the Next.js runtime reads it from `.env` or `.env.local`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# Optional: direct (non-pooled) connection string used by Prisma migrations
# when DATABASE_URL is a pooled (pgbouncer) URL — see docs/README.md.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?sslmode=require"

# ─── Auth (required for login to work) ───────────────────────────────────────
# Auth.js v5 uses this secret to sign JWT session tokens and cookies.
# REQUIRED in production. Generate one with:
#   openssl rand -base64 32
# NOTE: in development (`next dev`), the app falls back to a built-in
# development-only secret, so it boots even before you set this — but always
# set a real one.
AUTH_SECRET=""

# Next.js is served behind a proxy (Vercel, previews, etc.) — keep enabled.
AUTH_TRUST_HOST=true

# Public URL of the app (used for redirects, links, and CORS).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OAuth providers (optional — Google login) ───────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/ → APIs & auth →
# Credentials → OAuth 2.0 Client ID. Add
#   http://localhost:3000/api/auth/callback/google
# as an Authorized redirect URI for development.
# Google login button only appears when both variables are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: extra CORS origins allowed to call the API, comma-separated.
# NEXT_PUBLIC_CORS_ORIGINS="https://admin.example.com"

# ─── Email (optional — features degrade gracefully) ──────────────────────────
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Serene Dental <no-reply@serenedental.com>"

# ─── Rate limiting (optional — safe defaults) ────────────────────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# ─── Encryption (optional — only used to protect sensitive stored fields) ────
# ENCRYPTION_KEY=""
