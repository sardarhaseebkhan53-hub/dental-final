# ─────────────────────────────────────────────────────────────────────────────
# Junaid Dental Care — environment configuration
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database (required) ─────────────────────────────────────────────────────
# PostgreSQL connection string (local DB by default).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/junaid_dental?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Public URL of the site.
APP_URL="http://localhost:3000"
# Extra CORS origins (comma-separated) allowed to call the API, if needed.
# CORS_ORIGINS="https://admin.example.com"

# ─── Auth (required for login to work) ───────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="change-me-generate-a-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Rate limiting (optional — safe defaults) ────────────────────────────────
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# ─── Uploads (optional) ─────────────────────────────────────────────────────
# MAX_UPLOAD_MB=8
# UPLOAD_DIR=""
